{
  "_about": "Real-world results per agent, by the metric that decides whether the agent's work succeeded in the world, not only whether it ran well. Values are AGGREGATES only (counts, rates, medians): no names, contacts or content. Every value is recorded with its source (`agent-metrics.mjs result`) so the auditor can check where it came from. Under min_n the auditor says 'too little data', never pass or fail. Written by Claude from Yotam's rule (Nov 2026); Yotam confirms the thresholds.",
  "agents": {
    "marketing": {
      "judged_by": "what the videos and posts did in the world after Yotam approved and published them (reach, views, saves, shares, contacts) and his verdicts on the drafts",
      "source_hint": "portfolio analytics / Meta insights for the post that used the video; outcomes.jsonl",
      "min_n": 3,
      "metrics": [
        {
          "id": "videos_delivered",
          "unit": "count"
        },
        {
          "id": "videos_approved_first_cut",
          "unit": "count"
        },
        {
          "id": "video_views_median",
          "unit": "views",
          "compare": "baseline"
        },
        {
          "id": "contacts_after_video",
          "unit": "count"
        },
        {
          "id": "posts_published",
          "unit": "count"
        },
        {
          "id": "reach_median",
          "unit": "accounts",
          "compare": "baseline"
        },
        {
          "id": "three_sec_view_rate",
          "unit": "ratio",
          "compare": "baseline"
        },
        {
          "id": "saves_shares_per_reach",
          "unit": "ratio",
          "compare": "baseline"
        },
        {
          "id": "follows_gained",
          "unit": "count"
        },
        {
          "id": "link_clicks",
          "unit": "count"
        },
        {
          "id": "experiments_proposed",
          "unit": "count"
        },
        {
          "id": "experiments_decided_with_data",
          "unit": "count"
        }
      ]
    },
    "projects-scout": {
      "judged_by": "quality and conversion of verified opportunities, not volume of data collected (spec 8.8)",
      "source_hint": "opportunity-audit.mjs stats, sources.json, outreach.json, Yotam's own records",
      "min_n": 5,
      "metrics": [
        {
          "id": "active_allowed_sources",
          "unit": "count"
        },
        {
          "id": "sources_without_manual_step_rate",
          "unit": "ratio"
        },
        {
          "id": "verified_opportunities",
          "unit": "count"
        },
        {
          "id": "rejected_by_audit_rate",
          "unit": "ratio"
        },
        {
          "id": "inferred_opportunity_share",
          "unit": "ratio",
          "note": "opportunities not yet published as projects"
        },
        {
          "id": "missed_found_by_audit",
          "unit": "count"
        },
        {
          "id": "manual_hours_saved",
          "unit": "hours",
          "note": "Yotam's estimate"
        },
        {
          "id": "offers_sent",
          "unit": "count"
        },
        {
          "id": "offers_replied",
          "unit": "count"
        },
        {
          "id": "converted_to_paying",
          "unit": "count"
        },
        {
          "id": "revenue_attributed",
          "unit": "currency per period, Yotam's records"
        },
        {
          "id": "policy_violations",
          "unit": "count",
          "note": "must be 0"
        }
      ]
    },
    "product-customers": {
      "judged_by": "whether the prospects it found became regular paying customers",
      "source_hint": "D2R lead/customer records (aggregated by Yotam or an ingest read-back)",
      "min_n": 10,
      "metrics": [
        {
          "id": "approved_and_contacted",
          "unit": "count"
        },
        {
          "id": "replied",
          "unit": "count"
        },
        {
          "id": "trials_started",
          "unit": "count"
        },
        {
          "id": "paying_customers",
          "unit": "count"
        },
        {
          "id": "paying_after_2_periods",
          "unit": "count",
          "note": "recurring = still paying after at least two consecutive billing periods"
        }
      ]
    },
    "sales": {
      "judged_by": "speed of answering and whether leads became paying",
      "source_hint": "D2R lead records",
      "min_n": 5,
      "metrics": [
        {
          "id": "median_first_response_hours",
          "unit": "hours"
        },
        {
          "id": "leads_to_paying",
          "unit": "count"
        },
        {
          "id": "leads_total",
          "unit": "count"
        },
        {
          "id": "quotes_sent",
          "unit": "count"
        },
        {
          "id": "quotes_accepted",
          "unit": "count"
        },
        {
          "id": "price_realized_vs_proposed",
          "unit": "ratio"
        }
      ]
    },
    "auditor": {
      "judged_by": "whether its verdicts agree with Yotam's own verdicts on the same items",
      "source_hint": "audits.jsonl vs outcomes.jsonl",
      "min_n": 5,
      "metrics": [
        {
          "id": "agreement_with_yotam",
          "unit": "ratio"
        }
      ]
    }
  }
}